# 操作系统与编辑器临时文件
.DS_Store
Thumbs.db
.idea/
*.iml

# Python / 构建 / 测试缓存
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.mypy_cache/
.pyre/
.pytype/
.coverage
htmlcov/
.pytest_cache/

# 本地运行状态、日志和临时目录
.tmp/
logs/
.label-studio-data/
/.claude/worktrees/

# 环境变量、私密配置和密钥
.env
*.pem
*.key
config/*local*.yaml

# 模型权重和导出模型通常体积大，只提交下载说明或 .gitkeep
*.pt
*.onnx
*.pth
models/**/*.pt
models/**/*.onnx
models/**/*.pth
!models/.gitkeep

# 通用规则：训练/标注过程产物不进 Git；类别配置、文档和 .gitkeep 可以提交
/datasets/**/raw/images/
/datasets/**/raw/metadata/*.txt
/datasets/**/raw/metadata/*.csv
/datasets/**/raw/metadata/*.json
/datasets/**/ocr/metadata/*.txt
/datasets/**/ocr/metadata/*.csv
/datasets/**/ocr/metadata/*.json
/datasets/**/pseudo/images/
/datasets/**/pseudo/labels/
/datasets/**/pseudo/metadata/*.txt
/datasets/**/pseudo/metadata/*.csv
/datasets/**/pseudo/metadata/*.json
/datasets/**/images/
/datasets/**/labels/
/datasets/**/label_studio/*label_studio_import.json
/datasets/**/label_studio/label_config.xml
/datasets/**/label_studio/exports/
/datasets/**/ab_tests/
/datasets/**/metadata/*.json
/datasets/**/metadata/*.csv
/datasets/**/metadata/*.txt
/datasets/**/visual_prompts/**
!/datasets/**/.gitkeep

# 可选本地图片导入暂存目录
/data/local_import/

# 训练、推理和云端归档输出
/outputs/*
!/outputs/.gitkeep
/runs/
/artifacts/**
!/artifacts/**/.gitkeep

# 自动生成的 YOLO 数据集配置；保留目录占位
/config/generated/*.yaml
!/config/generated/.gitkeep

/datasets_bak/
